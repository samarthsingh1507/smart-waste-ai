# Database configuration
DATABASE_URL=sqlite:///./smart_waste.db

# Gemini AI Vision API Key
# Optional: If left blank or unset, system operates in explicitly labelled DEMO MODE.
# To activate genuine Gemini Vision analysis, set your valid API key below:
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini model name
GEMINI_MODEL=gemini-2.0-flash

# Kitchen Outlet Defaults
OUTLET_NAME_DEFAULT="Green Olive Bistro & Banquet"
CURRENCY_DEFAULT="₹"
WEIGHT_UNIT_DEFAULT="kg"
SAFETY_BUFFER_DEFAULT_PCT=5.0
