# Smart Waste AI - Environment Variables Template
# Copy this file to backend/.env

# Database Connection (Default: SQLite local database; supports PostgreSQL via postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///./smart_waste.db

# Google Gemini Vision API Key
# Leave blank to operate in explicitly labelled DEMO MODE with the simulated kitchen classifier.
# To activate genuine live Gemini Vision image analysis, supply your API key:
GEMINI_API_KEY=

# Configurable Gemini Vision Model
GEMINI_MODEL=gemini-2.0-flash

# Default Kitchen Outlet Configuration
OUTLET_NAME_DEFAULT="Green Olive Bistro & Banquet"
CURRENCY_DEFAULT="₹"
WEIGHT_UNIT_DEFAULT="kg"
SAFETY_BUFFER_DEFAULT_PCT=5.0
